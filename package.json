{
  "name": "aiguidepage",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "i18n:check": "node scripts/check-i18n.mjs",
    "test:e2e": "playwright test",
    "test:admin": "node --conditions=react-server --experimental-strip-types --test tests/firebase-admin.node.mjs tests/emulator-guard.node.mjs",
    "firebase:check": "node --env-file-if-exists=.env.local --conditions=react-server --experimental-strip-types scripts/check-firebase-admin.mjs",
    "seed": "node --env-file-if-exists=.env.local --conditions=react-server --experimental-strip-types scripts/seed.mjs",
    "grant-admin": "node --env-file-if-exists=.env.local --conditions=react-server --experimental-strip-types scripts/grant-admin.mjs",
    "firebase:deploy": "node --env-file-if-exists=.env.local --conditions=react-server --experimental-strip-types scripts/configure-firebase.mjs --apply",
    "dev:emulator": "node scripts/dev-emulator.mjs",
    "test:portal": "node --conditions=react-server --experimental-strip-types --test tests/portal.node.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.2.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "next": "^16.4.0",
    "next-intl": "^4.14.9",
    "pretendard": "^1.3.9",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "overrides": {
    "jwks-rsa": {
      "jose": "5.10.0"
    },
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.14.5"
    },
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@lobehub/icons-static-svg": "^1.95.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "firebase-tools": "^15.32.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
