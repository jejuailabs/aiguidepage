# Firebase Console > Project settings > Your apps > Web app configuration
# Public browser configuration; never put an Admin SDK private key here.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional. Analytics runs only in production browsers when this is set.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Server only. Never prefix these variables with NEXT_PUBLIC_.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Quoted PEM with escaped newlines, or a quoted multiline PEM value.
FIREBASE_ADMIN_PRIVATE_KEY=
# Optional: verified sign-in by this email bootstraps the platform operator.
PLATFORM_ADMIN_EMAIL=
# Optional server override; defaults to NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET.
FIREBASE_STORAGE_BUCKET=
